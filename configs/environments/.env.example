# HistoryVerse API Microservice Environment Configuration
# Copy this file to .env and configure your secret API keys

ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Multi-Domain Agent Persona Configuration
AGENT_PERSONA_NAME=Mora
AGENT_PERSONA_ID=historyverse-mora

# LLM Provider Configuration ('gemini', 'openai', 'local', 'ollama')
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_TOP_P=0.95
LLM_TOP_K=40

# Cloud Provider API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Local LLM & Ollama Configuration
LLM_LOCAL_MODEL_PATH=./models
LLM_MODEL_BASENAME=llama-2-7b-chat.Q4_K_M.gguf
LLM_AUTO_DOWNLOAD=true
LLM_DEVICE_TYPE=cpu
LLM_N_GPU_LAYERS=0
LLM_N_BATCH=512
LLM_CONTEXT_WINDOW=4096
OLLAMA_BASE_URL=http://localhost:11434

# RAG & Chroma Vector Database
CHROMA_PERSIST_DIRECTORY=./DB
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVER_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Modality & Feature Toggles
ENABLE_RAG=true
ENABLE_VOICE=true
ENABLE_VISION=true
ENABLE_VIDEO_GEN=false
ENABLE_UNLEARNING=true
ENABLE_PROMETHEUS=true
ENABLE_LANGFUSE=false
ENABLE_MLFLOW=true

# Distributed Redis Memory
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2.0

# Storage & Guardrails
OUTPUTS_DIR=./outputs
DATASET_DIR=./dataset
PROMPTS_DIR=./configs/prompts
MIN_DISK_FREE_GB=0.5
