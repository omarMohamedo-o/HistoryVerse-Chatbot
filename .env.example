# ==============================================================================
# HistoryVerse Environment Configuration
# Copy this file to .env and configure for your local/production environment.
# ==============================================================================

# ── Service Identification & API Server ──────────────────────────────────────
SERVICE_NAME=historyverse-api
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# ── LLM Settings & Model Selection ──────────────────────────────────────────
# Available providers: gemini, openai, local, ollama
LLM_PROVIDER=gemini
# Examples:
#   gemini: gemini/gemini-1.5-flash, gemini/gemini-1.5-pro
#   openai: gpt-4o, gpt-4o-mini
#   ollama: ollama/llama3.2:3b, ollama/mistral
#   local: TheBloke/Llama-2-7B-Chat-GGUF (with model basename)
LLM_MODEL_NAME=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_TOP_P=0.95
LLM_TOP_K=40

# ── Local Model Storage & Auto-Download ──────────────────────────────────────
LLM_LOCAL_MODEL_PATH=./models
LLM_MODEL_BASENAME=llama-2-7b-chat.Q4_K_M.gguf
LLM_AUTO_DOWNLOAD=true
LLM_DEVICE_TYPE=cpu
LLM_N_GPU_LAYERS=0
LLM_N_BATCH=512
LLM_CONTEXT_WINDOW=4096

# ── API Keys ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# ── Langfuse (Prompt Management & Tracing & Experiment Tracking) ─────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_SYSTEM_PROMPT_VERSION=v1.0
LANGFUSE_USER_PROMPT_VERSION=v1.0

# ── RAG, Embeddings & Vector Store (ChromaDB) ────────────────────────────────
CHROMA_PERSIST_DIR=./DB
SOURCE_DOCUMENTS_DIR=./dataset
EMBEDDING_PROVIDER=google
# Examples:
#   google: models/embedding-001 or text-embedding-004
#   huggingface: hkunlp/instructor-large or sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=models/embedding-001
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# ── Ingestion & CPU Resource Management ──────────────────────────────────────
INGEST_WORKERS=4
INGEST_CHUNK_SIZE_PYTHON=880

# ── Voice Processing (Whisper STT & gTTS) ────────────────────────────────────
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_TLD=co.uk

# ── Drift Detection, Ragas Metrics & Auto-Rerun / Docker Rebuild Trigger ─────
# Confidence threshold below which drift is detected and re-run triggered
DRIFT_CONFIDENCE_THRESHOLD=0.65
DRIFT_MAX_RETRIES=2
DRIFT_FALLBACK_MODEL=gemini/gemini-1.5-pro
# Minimum acceptable RAGAS evaluation thresholds (0.0 to 1.0)
RAGAS_MIN_FAITHFULNESS=0.70
RAGAS_MIN_ANSWER_RELEVANCY=0.70
RAGAS_MIN_CONTEXT_RECALL=0.65
RAGAS_MIN_CONTEXT_PRECISION=0.65
# Trigger action on sustained degradation: log, alert, docker_rebuild
DRIFT_ACTION=alert
DOCKER_REBUILD_COMMAND=docker compose build historyverse-api && docker compose up -d historyverse-api

# ── Memory & Conversation Management ─────────────────────────────────────────
MAX_CONVERSATION_HISTORY=50
